APP_NAME=CourierAI
APP_ENV=local
APP_KEY=
# Mantén false en producción y en una demo pública.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courier_ai
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
REVERB_APP_ID=local-demo
REVERB_APP_KEY=local-demo-key
REVERB_APP_SECRET=local-demo-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Courier AI: valores no secretos y servicios opcionales
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=2
OSRM_RETRIES=2
OSRM_RETRY_SLEEP_MS=100
OSRM_CACHE_TTL_SECONDS=120
ROAD_FACTOR=1.25
FALLBACK_SPEED_KMH=30
ROUTING_ALGORITHM_VERSION=v1

LLM_PROVIDER=none
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=5
LLM_RETRIES=1
LLM_RETRY_SLEEP_MS=100
LLM_MAX_TOKENS=180

SIMULATION_SPEED_MULTIPLIER=1
SIMULATION_TIMEZONE=America/Monterrey
SIMULATION_VEHICLE=motorcycle
SIMULATION_INITIAL_LAT=25.675
SIMULATION_INITIAL_LON=-100.310
DEFAULT_COST_PER_KM_MXN=1.25
MAX_CONCURRENT_ORDERS=2
MAX_POSITION_BONUS_MXN=20

COURIER_ALGORITHM_VERSION=v1
DEMO_ACCESS_TOKEN=
